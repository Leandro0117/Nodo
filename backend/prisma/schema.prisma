// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  savings
  checking
}

enum PostStatus {
  pending
  in_progress
  finished
  cancelled
}

enum ApplicationStatus {
  pending
  accepted
  rejected
  withdrawn
}

enum TransactionStatus {
  pending
  completed
  failed
  refunded
}

enum ServiceStatus {
  in_progress
  completed
  cancelled
}

enum BalanceMovementType {
  credit
  debit
}

enum WithdrawalType {
  batched
  instant
}

enum WithdrawalStatus {
  pending
  completed
  failed
}

enum MessageStatus {
  sent
  read
  deleted
}

enum DisputeStatus {
  pending
  in_review
  resolved
  rejected
}

// under_review queda reservado para cuando exista moderación: por ahora
// ningún flujo lo asigna, pero ya bloquea el acceso.
enum UserStatus {
  active
  under_review
  deactivated
}

enum ReportStatus {
  pending
  reviewed
  resolved
}

// ===== CATEGORIES =====

// Tabla auxiliar/de consulta: baja cardinalidad, se une frecuentemente y
// nunca es objeto de validaciones de autorización, así que un id entero
// secuencial es seguro y mejor para el rendimiento.
model GeneralCategory {
  id   Int    @id @default(autoincrement())
  name String

  hierarchyLinks   CategoryHierarchy[]
  workerCategories WorkerCategory[]

  @@map("general_category")
}

model SpecificCategory {
  id   Int    @id @default(autoincrement())
  name String

  hierarchyLinks CategoryHierarchy[]
  postCategories PostCategory[]

  @@map("specific_category")
}

model CategoryHierarchy {
  generalCategoryId  Int @map("general_category_id")
  specificCategoryId Int @map("specific_category_id")

  generalCategory  GeneralCategory  @relation(fields: [generalCategoryId], references: [id])
  specificCategory SpecificCategory @relation(fields: [specificCategoryId], references: [id])

  @@id([generalCategoryId, specificCategoryId])
  @@map("category_hierarchy")
}

model Location {
  id   Int    @id @default(autoincrement())
  name String @unique

  @@map("location")
}

// ===== USERS =====

model AppUser {
  id               String     @id @default(uuid())
  firstName        String     @map("first_name")
  lastName         String     @map("last_name")
  secondLastName   String?    @map("second_last_name")
  dni              String     @unique
  email            String     @unique
  phone            String     @unique
  birthDate        DateTime   @map("birth_date") @db.Date
  passwordHash     String     @map("password_hash")
  registrationDate DateTime   @default(now()) @map("registration_date")
  profilePhoto     String?    @map("profile_photo")
  verified         Boolean    @default(false)
  location         String?
  fcmToken         String?    @map("fcm_token")
  // "¿Puede entrar?". Es distinto de verified ("¿confirmó su celular?").
  status           UserStatus @default(active)
  // Usuario que Firebase crea al verificar el celular. Hace falta para
  // borrarlo al desactivar la cuenta; si ese borrado falla, se conserva
  // para poder reintentarlo. No es único: Firebase reutiliza el uid de un
  // número, así que quien vuelve a registrarse con el mismo celular puede
  // traer el uid que quedó pendiente en su cuenta desactivada.
  firebaseUid      String?    @map("firebase_uid")

  bankAccounts      BankAccount[]
  worker            Worker?
  posts             Post[]        @relation("ClientPosts")
  sentMessages      Message[]
  reviewsGiven      Review[]      @relation("Reviewer")
  reviewsReceived   Review[]      @relation("Reviewed")
  disputesInitiated Dispute[]
  reports           Report[]

  @@map("app_user")
}

// Any user (client or worker) can register a bank account: workers use it
// to receive earnings, clients only if a refund needs a manual transfer.
model BankAccount {
  id                   String      @id @default(uuid())
  userId               String      @map("user_id")
  bank                 String
  accountType          AccountType @map("account_type")
  accountNumber        String      @map("account_number")
  gatewayBeneficiaryId String?     @map("gateway_beneficiary_id")
  registrationDate     DateTime    @default(now()) @map("registration_date")

  user        AppUser      @relation(fields: [userId], references: [id])
  withdrawals Withdrawal[]

  @@map("bank_account")
}

// Exists only if this person also offers services. Doesn't exclude the
// same user from also being a client.
model Worker {
  userId      String  @id @map("user_id")
  description String?

  user             AppUser           @relation(fields: [userId], references: [id])
  workerCategories WorkerCategory[]
  applications     Application[]
  balanceMovements BalanceMovement[]
  withdrawals      Withdrawal[]

  @@map("worker")
}

model WorkerCategory {
  workerId          String @map("worker_id")
  generalCategoryId Int    @map("general_category_id")

  worker          Worker          @relation(fields: [workerId], references: [userId])
  generalCategory GeneralCategory @relation(fields: [generalCategoryId], references: [id])

  @@id([workerId, generalCategoryId])
  @@map("worker_category")
}

// ===== POST =====

model Post {
  id          String     @id @default(uuid())
  clientId    String     @map("client_id")
  title       String
  description String?
  location    String?
  budget      Float?
  postDate    DateTime   @default(now()) @map("post_date")
  deadline    DateTime?
  status      PostStatus @default(pending)

  client       AppUser        @relation("ClientPosts", fields: [clientId], references: [id])
  photos       PostPhoto[]
  categories   PostCategory[]
  applications Application[]
  reports      Report[]

  @@map("post")
}

model PostPhoto {
  id        Int    @id @default(autoincrement())
  postId    String @map("post_id")
  url       String
  sortOrder Int?   @map("sort_order")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("post_photo")
}

model PostCategory {
  postId             String @map("post_id")
  specificCategoryId Int    @map("specific_category_id")

  post             Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  specificCategory SpecificCategory @relation(fields: [specificCategoryId], references: [id])

  @@id([postId, specificCategoryId])
  @@map("post_category")
}

// ===== APPLICATION =====
// Backend-enforced rule (not expressible as a constraint): a worker can
// re-apply to the same post if their last application was 'withdrawn',
// but NOT if it was 'rejected'.

model Application {
  id              String            @id @default(uuid())
  postId          String            @map("post_id")
  workerId        String            @map("worker_id")
  applicationDate DateTime          @default(now()) @map("application_date")
  status          ApplicationStatus @default(pending)

  post         Post          @relation(fields: [postId], references: [id])
  worker       Worker        @relation(fields: [workerId], references: [userId])
  service      Service?
  conversation Conversation?

  @@map("application")
}

// ===== TRANSACTION (client charge) =====

model Transaction {
  id              String            @id @default(uuid())
  amount          Float
  gatewayFee      Float?            @map("gateway_fee")
  appFee          Float?            @map("app_fee")
  transactionDate DateTime          @default(now()) @map("transaction_date")
  status          TransactionStatus @default(pending)
  paymentMethod   String?           @map("payment_method")
  transactionCode String            @unique @map("transaction_code")

  service Service?

  @@map("transaction")
}

// ===== SERVICE =====
// One worker per service. Originates when a specific application is
// accepted. A post can generate more than one service over time (e.g. if
// the assigned worker withdraws and a new application is accepted later).
// transactionId stays null until payment settles.

model Service {
  id            String        @id @default(uuid())
  applicationId String        @unique @map("application_id")
  transactionId String?       @unique @map("transaction_id")
  startDate     DateTime?     @map("start_date")
  endDate       DateTime?     @map("end_date")
  status        ServiceStatus @default(in_progress)

  application      Application       @relation(fields: [applicationId], references: [id])
  transaction      Transaction?      @relation(fields: [transactionId], references: [id])
  balanceMovements BalanceMovement[]
  reviews          Review[]
  disputes         Dispute[]

  @@map("service")
}

// ===== WORKER INTERNAL BALANCE =====
// Balance is never a fixed column: always SUM(credits) - SUM(debits) from
// this ledger, so it can never drift out of sync.

model BalanceMovement {
  id           Int                 @id @default(autoincrement())
  workerId     String              @map("worker_id")
  type         BalanceMovementType
  amount       Float
  date         DateTime            @default(now())
  serviceId    String?             @map("service_id")
  withdrawalId String?             @map("withdrawal_id")

  worker     Worker      @relation(fields: [workerId], references: [userId])
  service    Service?    @relation(fields: [serviceId], references: [id])
  withdrawal Withdrawal? @relation(fields: [withdrawalId], references: [id])

  @@map("balance_movement")
}

// Payout from the platform to the worker via payment gateway. References
// the exact bank account used, so historical withdrawals stay accurate
// even if the worker later registers a different account. The 'debit'
// balance_movement for this withdrawal must only be created once status
// becomes 'completed', never at request time.
model Withdrawal {
  id              String           @id @default(uuid())
  workerId        String           @map("worker_id")
  bankAccountId   String           @map("bank_account_id")
  amount          Float
  type            WithdrawalType
  fee             Float?
  requestDate     DateTime         @default(now()) @map("request_date")
  completionDate  DateTime?        @map("completion_date")
  status          WithdrawalStatus @default(pending)
  transactionCode String           @unique @map("transaction_code")

  worker           Worker            @relation(fields: [workerId], references: [userId])
  bankAccount      BankAccount       @relation(fields: [bankAccountId], references: [id])
  balanceMovements BalanceMovement[]

  @@map("withdrawal")
}

// ===== CONVERSATION AND MESSAGES =====

model Conversation {
  id            String @id @default(uuid())
  applicationId String @unique @map("application_id")

  application Application @relation(fields: [applicationId], references: [id])
  messages    Message[]

  @@map("conversation")
}

model Message {
  id             String        @id @default(uuid())
  conversationId String        @map("conversation_id")
  senderId       String        @map("sender_id")
  sentAt         DateTime      @default(now()) @map("sent_at")
  content        String
  status         MessageStatus @default(sent)

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       AppUser      @relation(fields: [senderId], references: [id])

  @@map("message")
}

// ===== REVIEW =====

model Review {
  id         String   @id @default(uuid())
  reviewerId String   @map("reviewer_id")
  reviewedId String   @map("reviewed_id")
  serviceId  String   @map("service_id")
  rating     Int
  comment    String?
  reviewDate DateTime @default(now()) @map("review_date")

  reviewer AppUser @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewed AppUser @relation("Reviewed", fields: [reviewedId], references: [id])
  service  Service @relation(fields: [serviceId], references: [id])

  @@unique([reviewerId, serviceId])
  @@map("review")
}

// ===== DISPUTE =====
// Can only exist once a formal service relationship exists.

model Dispute {
  id          String        @id @default(uuid())
  serviceId   String        @map("service_id")
  initiatorId String        @map("initiator_id")
  description String?
  status      DisputeStatus @default(pending)
  createdAt   DateTime      @default(now()) @map("created_at")
  resolvedAt  DateTime?     @map("resolved_at")

  service   Service           @relation(fields: [serviceId], references: [id])
  initiator AppUser           @relation(fields: [initiatorId], references: [id])
  evidence  DisputeEvidence[]

  @@map("dispute")
}

model DisputeEvidence {
  id        Int    @id @default(autoincrement())
  disputeId String @map("dispute_id")
  url       String

  dispute Dispute @relation(fields: [disputeId], references: [id])

  @@map("dispute_evidence")
}

// ===== REPORT =====
// A user can only report the same post once.

model Report {
  id        String       @id @default(uuid())
  postId    String       @map("post_id")
  userId    String       @map("user_id")
  reason    String?
  status    ReportStatus @default(pending)
  createdAt DateTime     @default(now()) @map("created_at")

  post Post    @relation(fields: [postId], references: [id])
  user AppUser @relation(fields: [userId], references: [id])

  @@unique([userId, postId])
  @@map("report")
}
